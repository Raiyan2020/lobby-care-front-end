# ─── Backend API ───────────────────────────────────────────────────────────────
# Base URL for the Lobby Care REST API, no trailing slash.
#
# This is the only environment variable the frontend reads (src/api/config.ts).
# It is a NEXT_PUBLIC_* value, so Next.js inlines it into the client bundle and
# it is publicly visible — never put a secret here.
#
#   production : https://portal.lobby-care.raiyan.cc/api/v1
#   local      : http://127.0.0.1:8000/api/v1
#
# Note the /api/v1 suffix: the API modules append paths like /general/config and
# /user/login to this value.
NEXT_PUBLIC_API_BASE_URL=https://portal.lobby-care.raiyan.cc/api/v1

# Canonical storefront origin used by server-side redirects behind a reverse proxy.
NEXT_PUBLIC_SITE_URL=https://lobby-care.raiyan.cc

# Local overrides belong in .env.local, which Next.js loads after .env.
# Both files are gitignored.
